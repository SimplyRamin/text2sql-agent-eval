# LLM provider — reseller endpoint (Iranian-accessible), OpenAI-compatible
API_BASE_URL=
API_KEY=

# Local Ollama (Mac dev machine only — leave unset on Windows, llm.py should
# treat a missing OLLAMA_HOST as "local model unavailable on this machine")
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Hard budget ceiling, enforced in src/budget.py — do not raise casually
BUDGET_LIMIT_USD=3.00
